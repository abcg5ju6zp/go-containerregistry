+
+//go:build !aix && !js && !wasip1 && !windows
+
+package tarball
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// targetLock is an advisory, process-durable exclusive lock. The kernel
+// releases it automatically if the process exits or is killed, so a crashed
+// export never blocks future ones.
+type targetLock struct {
+	f *os.File
+}
+
+func acquireTargetLock(p string) (*targetLock, error) {
+	f, err := os.OpenFile(p, os.O_RDWR|os.O_CREATE, 0o600)
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Flock(int(f.Fd()), unix.LOCK_EX); err != nil {
+		_ = f.Close()
+		return nil, err
+	}
+	return &targetLock{f: f}, nil
+}
+
+func (l *targetLock) Unlock() {
+	_ = unix.Flock(int(l.f.Fd()), unix.LOCK_UN)
+	_ = l.f.Close()
+}
