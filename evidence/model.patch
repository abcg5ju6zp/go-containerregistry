+func (c *byteCounter) Read(p []byte) (int, error) {
+	n, err := c.rc.Read(p)
+	if n > 0 {
+		atomic.AddInt64(c.n, int64(n))
+	}
+	return n, err
+}
+func (c *byteCounter) Close() error { return c.rc.Close() }
